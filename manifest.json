{
  "manifest_version": 3,
  "name": "PostPocket — Facebook Photo Organizer",
  "short_name": "PostPocket",
  "version": "2.2.0",
  "description": "One post. One folder. Every image together. Organize Facebook photos locally, import your own archive, and export ZIPs — all on your device.",
  "permissions": ["downloads", "storage", "activeTab", "scripting", "offscreen", "unlimitedStorage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "dist/src/ui-react/popup.html",
    "default_title": "PostPocket — organize this post",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "dist/src/ui-react/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://m.facebook.com/*",
        "https://mbasic.facebook.com/*"
      ],
      "js": [
        "src/shared/utils.js",
        "src/shared/scanner.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
